#!/bin/sh
set -e

if [ "${MAKO_SKIP_POSTINST:-}" = "1" ]; then
    echo "Skipping mako-server post-install steps due to MAKO_SKIP_POSTINST=1"
    exit 0
fi

if ! command -v systemctl >/dev/null 2>&1 || [ ! -d /run/systemd/system ]; then
    echo "Skipping mako-server startup because systemd is not running"
    exit 0
fi

systemctl enable --now mako-server
