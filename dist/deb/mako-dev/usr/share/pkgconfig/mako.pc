prefix=/usr
libdir=${prefix}/lib/@DEB_HOST_MULTIARCH@
includedir=${prefix}/include/realtimelogic
modulesdir=${prefix}/share/mako/modules/@LUA_VERSION@
luaversion=@LUA_VERSION@

Name: mako
Description: Mako Server - Embedded web server with Lua support
Version: @VERSION_MAKO@
Cflags: -I${includedir} -I${includedir}/arch/Posix -DMAKO -DUSE_EMBEDDED_ZIP=0 -DLUA_USE_LINUX -DBA_FILESIZE64 -DUSE_LUAINTF=1 -DUSE_DBGMON=1 -DUSE_OPCUA=0
Libs: -L${libdir} -lmako -lpthread -lm -ldl
